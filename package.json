{
  "name": "m0sh-timestretch-player",
  "version": "1.0.0",
  "description": "A focused desktop player for slowing down, tuning, and studying audio.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "start": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "pack": "npm run build && electron-builder",
    "publish:win": "npm run build && electron-builder --win nsis --publish always",
    "release": "node scripts/release.cjs"
  },
  "devDependencies": {
    "@soundtouchjs/audio-worklet": "^2.1.1",
    "concurrently": "^9.2.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.m0sh.timestretch",
    "productName": "M0SH TimeStretch",
    "directories": { "output": "release" },
    "files": ["web-dist/**/*", "electron/**/*.cjs", "package.json", "!**/*.map", "!**/*.md", "!**/node_modules/.cache{,/**/*}"],
    "extraResources": [
      { "from": "resources/audiowaveform.exe", "to": "audiowaveform/audiowaveform.exe" },
      { "from": "resources/audiowaveform-COPYING", "to": "audiowaveform/COPYING" },
      { "from": "resources/audiowaveform-source-1.10.2.zip", "to": "audiowaveform/source-1.10.2.zip" },
      { "from": "resources/AUDIOWAVEFORM-NOTICE.md", "to": "audiowaveform/NOTICE.md" }
    ],
    "asar": true,
    "compression": "maximum",
    "removePackageScripts": true,
    "electronLanguages": ["en-US"],
    "win": { "target": "nsis", "icon": "build/icons/mto-icon.ico" },
    "mac": { "target": "dmg", "icon": "build/icons/mto-icon.icns" },
    "linux": { "target": "AppImage", "icon": "public/mto-icon.png" },
    "publish": {
      "provider": "github",
      "owner": "MoshRadix",
      "repo": "TimeStretch",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
